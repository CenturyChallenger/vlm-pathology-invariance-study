# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyc

# Environments
.venv/
venv/
env/
.conda/

# Data and outputs -- never commit patient data, embeddings, or slide imagery
*.svs
*.ndpi
*.mrxs
*.tif
*.tiff
*.h5
*.hdf5
wsi_data/
embeddings/
perturbed_tiles/
downsampled/

# Matching manifests -- link pseudonymised ACC case IDs to demographic fields
# (sex, age, diagnosis class); covered by the ACC NDA/MTA/DUA, not for the repo.
matched_controls_manifest*.tsv
acc_manifest*.tsv

# Logs and checkpoints
*.log
production_progress.csv
*.checkpoint

# Generated figures (regenerated on demand by scripts/04_reporting/14_make_figures.py;
# scripts/04_reporting/data/ holds the checked-in Phase B statistical output that
# generates them and is NOT ignored)
scripts/04_reporting/figures/

# OS / editor
.DS_Store
.ipynb_checkpoints/
*.swp

# Credentials -- must never be committed
.env
*.token
